# PORT: Express server port (default 3000 for AI Studio environment)
PORT=3000

# MONGODB_URI: MongoDB Atlas connection string (e.g. mongodb+srv://username:password@cluster.mongodb.net/helpnest?retryWrites=true&w=majority)
# When not set, the platform uses a persistent, relational-structured local JSON store
MONGODB_URI="mongodb+srv://helpnest_admin:SAMPLE_PASSWORD@cluster0.helpnest.mongodb.net/helpnest?retryWrites=true&w=majority"

# CLOUDINARY: Cloud storage for customer defect photos and short problem videos
# When not set, the platform uses local authenticated secure storage under public/uploads/
CLOUDINARY_CLOUD_NAME="sample_cloud_name"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="sample_cloudinary_api_secret_key"

# GEMINI_API_KEY: Required for Gemma 4 / Google GenAI SDK calls on the server.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMMA_MODEL_ID: Verified Gemma 4 model identifier on Google GenAI SDK (defaults to gemma-4-26b-a4b-it)
GEMMA_MODEL_ID="gemma-4-26b-a4b-it"

# JWT_SECRET: Secret key used for signing server-side authentication tokens
JWT_SECRET="helpnest_sih2026_cooperative_secret_key"

# FRONTEND_URL: Optional URL for CORS allowed origins in production
FRONTEND_URL="https://localhost:3000"

# RAZORPAY_KEY_ID & RAZORPAY_KEY_SECRET: Optional Razorpay Sandbox credentials for live sandbox orders
RAZORPAY_KEY_ID="rzp_test_sampleHelpNestKey123"
RAZORPAY_KEY_SECRET="sampleRazorpaySecretKey456"

# DATABASE_URL: Optional PostgreSQL connection string
DATABASE_URL="postgresql://helpnest_user:sample_coop_pass@localhost:5432/helpnest_db"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
